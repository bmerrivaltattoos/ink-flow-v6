# Copy to .env locally. Put real values only in .env or your host's secret settings.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tattoo-reference-files
# Required UUID of the workspace served by THIS deployment; never accept from a client.
WORKSPACE_ID=
ADMIN_PASSWORD=
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
APP_URL=http://127.0.0.1:8787
# Match the workspace/business time zone, including daylight saving time.
TZ=America/Denver
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
RESERVATION_HOLD_MINUTES=30
REMINDER_1_HOURS=48
REMINDER_2_HOURS=24
# Local development only. The server disables this in production.
ALLOW_SIMULATED_PAYMENTS=false
